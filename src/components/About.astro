---
import { Image } from "astro:assets";
import about from "../assets/images/about.jpeg";
---

<!-- redesigned component -->
<section
	id="about"
	class="relative min-h-screen overflow-hidden bg-gradient-to-br from-slate-900 via-sky-900 to-slate-900"
>
	<div class="relative z-10 container mx-auto max-w-6xl px-8 py-20">
		<!-- Header with centered approach -->
		<div class="mb-16 text-center">
			<div class="mb-6 inline-flex items-center gap-3">
				<div class="h-1 w-12 rounded-full bg-gradient-to-r from-sky-400 to-sky-400"></div>
				<span class="text-sm font-semibold tracking-widest text-sky-300 uppercase">Our Story</span>
				<div class="h-1 w-12 rounded-full bg-gradient-to-r from-sky-400 to-sky-400"></div>
			</div>
			<h2
				class="bg-gradient-to-r from-white via-sky-200 to-purple-200 bg-clip-text text-5xl leading-tight font-bold text-transparent md:text-6xl"
			>
				About Us
			</h2>
		</div>

		<div class="grid items-center gap-16 lg:grid-cols-2">
			<div
				data-aos="fade-up"
				data-aos-offset="150"
				data-aos-delay="100"
				data-aos-duration="800"
				class="space-y-8"
			>
				<div class="mb-8 grid grid-cols-2 gap-4">
					<div class="rounded-xl border border-white/20 bg-white/10 p-4 backdrop-blur-sm">
						<div class="text-2xl font-bold text-sky-300">500+</div>
						<div class="text-sm text-gray-300">Products</div>
					</div>
					<div class="rounded-xl border border-white/20 bg-white/10 p-4 backdrop-blur-sm">
						<div class="text-2xl font-bold text-sky-300">UK+</div>
						<div class="text-sm text-gray-300">Coverage</div>
					</div>
				</div>
				<div class="space-y-6">
					<p class="text-xl leading-relaxed font-light text-gray-100">
						We deliver premium electronic solutions to businesses and individuals throughout the UK
						and international markets.
					</p>
					<p class="leading-relaxed text-gray-300">
						Our expertise spans across high-quality product distribution, competitive market
						pricing, and strategic partnerships with world-renowned technology brands. From
						enterprise-level bulk solutions to individual consumer needs, RS TRADES LEEDS LTD stands
						as your reliable technology distribution specialist.
					</p>
				</div>
				<div class="grid grid-cols-1 gap-4 pt-6 sm:grid-cols-2">
					<div class="flex items-center gap-3">
						<div class="h-2 w-2 animate-pulse rounded-full bg-sky-400"></div>
						<span class="text-sm text-gray-200">Premium Quality</span>
					</div>
					<div class="flex items-center gap-3">
						<div
							class="h-2 w-2 animate-pulse rounded-full bg-purple-400"
							style="animation-delay: 0.5s"
						>
						</div>
						<span class="text-sm text-gray-200">Global Partnerships</span>
					</div>
					<div class="flex items-center gap-3">
						<div class="h-2 w-2 animate-pulse rounded-full bg-sky-400" style="animation-delay: 1s">
						</div>
						<span class="text-sm text-gray-200">Competitive Pricing</span>
					</div>
					<div class="flex items-center gap-3">
						<div
							class="h-2 w-2 animate-pulse rounded-full bg-purple-400"
							style="animation-delay: 1.5s"
						>
						</div>
						<span class="text-sm text-gray-200">Trusted Service</span>
					</div>
				</div>
			</div>

			<!-- Image side with enhanced styling -->
			<div
				data-aos="fade-left"
				data-aos-offset="150"
				data-aos-delay="200"
				data-aos-duration="800"
				class="relative"
			>
				<div class="group relative">
					<!-- Decorative elements -->
					<div
						class="absolute -inset-4 rounded-2xl bg-gradient-to-r from-sky-400/20 to-purple-400/20 blur-xl transition-all duration-300 group-hover:blur-2xl"
					>
					</div>
					<div
						class="absolute top-4 left-4 h-20 w-20 rounded-full bg-gradient-to-br from-sky-400/30 to-transparent blur-xl"
					>
					</div>
					<div
						class="absolute right-4 bottom-4 h-32 w-32 rounded-full bg-gradient-to-br from-purple-400/30 to-transparent blur-xl"
					>
					</div>

					<!-- Main image container -->
					<div class="relative rounded-2xl border border-white/20 bg-white/10 p-2 backdrop-blur-sm">
						<Image
							class="h-80 w-full rounded-xl object-cover shadow-2xl lg:h-96"
							src={about}
							alt="Electronic products showcase"
						/>

						<!-- Overlay gradient -->
						<div
							class="pointer-events-none absolute inset-2 rounded-xl bg-gradient-to-t from-black/20 via-transparent to-transparent"
						>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
